{
  "name": "@never86/pain-leads-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "wrangler dev",
    "build": "prisma generate && tsc --project ./tsconfig.json",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "deploy:cloudflare": "bash ../../scripts/cloudflare-deploy.sh",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
